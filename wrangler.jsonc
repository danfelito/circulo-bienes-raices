{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circulo-bienes-raices",
  "main": "cloudflare/src/index.mjs",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "circulo-bienes-raices-db",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "CORS_ORIGIN": "",
    "CLOUDINARY_ROOT": "circulo-bienes-raices",
    "CONTACT_EMAIL": "",
    "CONTACT_PHONE": "",
    "WHATSAPP_NUMBER": "",
    "CONTACT_ADDRESS": ""
  },
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "circulo-bienes-raices-staging",
          "database_id": "435b0a4f-63bf-47c0-add9-d487a7f0e7e1",
          "migrations_dir": "cloudflare/migrations"
        }
      ],
      "vars": {
        "NODE_ENV": "staging",
        "CORS_ORIGIN": "",
        "CLOUDINARY_ROOT": "circulo-bienes-raices-staging",
        "CONTACT_EMAIL": "",
        "CONTACT_PHONE": "",
        "WHATSAPP_NUMBER": "",
        "CONTACT_ADDRESS": ""
      }
    }
  }
}
