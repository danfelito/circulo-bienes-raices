{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circulo-bienes-raices",
  "main": "cloudflare/src/index.mjs",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "circulo-bienes-raices-db",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "CORS_ORIGIN": "",
    "CONTACT_EMAIL": "",
    "CONTACT_PHONE": "",
    "WHATSAPP_NUMBER": "",
    "CONTACT_ADDRESS": ""
  }
}
