# Database
DATABASE_URL=postgresql://user:password@localhost:5432/circulo_bienes_raices

# Auth
JWT_SECRET=your-secret-key-change-in-production
ADMIN_EMAIL=admin@circulo.com
ADMIN_PASSWORD=Admin123!

# Cloudinary - fotografías y videos
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# OpenAI - lectura de documentos, fotografías y preparación de la ficha
OPENAI_API_KEY=your-openai-api-key
OPENAI_PROPERTY_MODEL=gpt-5

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
